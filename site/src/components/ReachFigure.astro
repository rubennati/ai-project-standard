---
/**
 * What an action does and does not reach, as a labelled table.
 *
 * Reach is carried by a word, never by colour alone (WCAG 1.4.1): the symbol
 * is decorative and the state is written out next to it.
 */
interface Row {
  target: string;
  state: string;
  reached: "yes" | "partial" | "no";
  note: string;
}

interface Props {
  caption: string;
  rows: Row[];
}

const { caption, rows } = Astro.props;

const glyph = { yes: "●", partial: "◐", no: "○" } as const;
---

<figure class="mt-6 rounded-lg border border-black/10 p-5 dark:border-white/10">
  <ul class="flex flex-col divide-y divide-black/10 dark:divide-white/10">
    {
      rows.map((row) => (
        <li class="flex flex-col gap-x-4 py-3 first:pt-0 last:pb-0 sm:flex-row sm:items-baseline">
          <p class="flex shrink-0 items-baseline gap-x-2 sm:w-56">
            <span
              class={row.reached === "no" ? "opacity-40" : "text-[var(--color-accent)]"}
              aria-hidden="true"
            >
              {glyph[row.reached]}
            </span>
            <span class="font-semibold">{row.target}</span>
          </p>
          <p class="mt-1 text-sm leading-6 sm:mt-0">
            <span class="font-semibold">{row.state}</span>
            <span class="text-zinc-700 dark:text-zinc-300"> — {row.note}</span>
          </p>
        </li>
      ))
    }
  </ul>
  <figcaption class="mt-4 border-t border-black/10 pt-3 text-sm text-zinc-700 dark:border-white/10 dark:text-zinc-300">
    {caption}
  </figcaption>
</figure>
