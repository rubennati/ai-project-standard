---
/**
 * JSON-LD structured data for search engines.
 *
 * Renders page-aware schemas. The homepage gets Organization + WebSite, while
 * other pages get a page-level schema by default. Page-specific schemas
 * (BreadcrumbList, Article, etc.) can be appended via the `extra` prop.
 */
interface Props {
  title: string;
  description: string;
  pageType?: "WebSite" | "WebPage" | "AboutPage" | "CollectionPage" | "Article";
  extra?: Record<string, unknown>[];
  lang?: string;
  /** Licence of this page's text. Pages rendered from `docs/` inherit the
   *  repository's MIT licence; everything written for the site is CC BY 4.0. */
  license?: string;
}

const {
  title,
  description,
  pageType = "WebPage",
  extra = [],
  lang = "en",
  license = "https://creativecommons.org/licenses/by/4.0/",
} = Astro.props;

import { lastmodForUrl } from "../../scripts/git-lastmod.mjs";
import { operator } from "../data/site";

const site = Astro.site?.toString() ?? "https://ai-standard.rubennati.at/";
const repoUrl = "https://github.com/rubennati/ai-project-standard";
const pageUrl = Astro.url.toString();

// dateModified comes from the same git lookup that feeds the sitemap, so the
// two can never disagree. Undefined when a page has no commit history yet, in
// which case the field is simply omitted rather than guessed.
const modified = lastmodForUrl(new URL(Astro.url.pathname, site).toString());
const author = { "@type": "Person", name: operator.name };
const publisher = {
  "@type": "Organization",
  name: "AI Standard",
  url: site,
  logo: { "@type": "ImageObject", url: `${site}icon.svg` },
};
const isHomePage = ["/", "/de", "/de/"].includes(Astro.url.pathname);

const organization = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "AI Standard",
  url: site,
  logo: `${site}icon.svg`,
  sameAs: [repoUrl],
};

const website = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "AI Standard",
  url: site,
  inLanguage: lang,
  description,
  license,
};

const page = {
  "@context": "https://schema.org",
  "@type": pageType,
  name: title,
  description,
  url: pageUrl,
  inLanguage: lang,
  license,
  // Article requires a headline and expects author, publisher and dates.
  // Without them the markup is present but incomplete, which earns nothing.
  ...(pageType === "Article"
    ? {
        headline: title,
        author,
        publisher,
        ...(modified ? { dateModified: modified, datePublished: modified } : {}),
      }
    : modified
      ? { dateModified: modified }
      : {}),
  isPartOf: {
    "@type": "WebSite",
    name: "AI Standard",
    url: site,
  },
};

const baseSchemas = isHomePage ? [organization, website] : [page];
const schemas = [...baseSchemas, ...extra];
---

{
  schemas.map((schema) => (
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(schema)}
    />
  ))
}
