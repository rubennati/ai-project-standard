---
import ArtifactLink from "./ArtifactLink.astro";
import EvidenceBand from "./EvidenceBand.astro";
import PageIntroduction from "./PageIntroduction.astro";
import NextStep from "./NextStep.astro";
import StopCondition from "./StopCondition.astro";
import { artifactHref, getVibeCoding, REVIEWED } from "../data/start/vibe-coding";
import { getLocalizedPath } from "../i18n/routes";
import type { SiteLocale } from "../i18n/ui";
import Base from "../layouts/Base.astro";

interface Props {
  locale: SiteLocale;
}

const { locale } = Astro.props;
const content = getVibeCoding(locale);
const base = import.meta.env.BASE_URL;
const toHref = (path: string) =>
  path === "/" ? base : `${base}${path.replace(/^\//, "")}`;
---

<Base
  title={content.title}
  description={content.description}
  ogType="article"
  schemaType="Article"
  locale={locale}
  routeKey="startVibeCoding"
>
  <article class="layout-reading prototype-path">
    <PageIntroduction
      locale={locale}
      job="decision"
      title={content.title}
      answer={content.answer}
      lead={content.lead}
      fit={content.fit}
      metadata={[{ label: content.reviewedLabel, value: REVIEWED, datetime: REVIEWED }]}
    />

    {/*
      No section eyebrow. "Possibility" and "Collaboration" were the product
      brief's spine stages printed on a public page, and in German
      "Möglichkeit" and "Zusammenarbeit" told a reader even less. Nothing takes
      their place: the headings say what each section answers, which is what an
      eyebrow was standing in for.
    */}
    <section class="prototype-section">
      <h2>{content.possibilityHeading}</h2>
      <p class="prototype-section__lead">{content.possibilityLead}</p>

      <div class="outcome-grid">
        {
          content.opportunities.map((opportunity) => (
            <article class="outcome-card">
              <h3>{opportunity.title}</h3>
              <dl>
                <div>
                  <dt>{content.outcomeLabel}</dt>
                  <dd>{opportunity.outcome}</dd>
                </div>
              </dl>
            </article>
          ))
        }
      </div>
    </section>

    <section class="prototype-section">
      <h2>{content.stagesHeading}</h2>
      <p class="prototype-section__lead">{content.stagesLead}</p>

      <div class="collaboration-grid">
        {
          content.stages.map((stage) => (
            <article class="collaboration-card">
              <h3>{stage.name}</h3>
              <dl>
                <div>
                  <dt>{content.workLabel}</dt>
                  <dd>{stage.work}</dd>
                </div>
                <div>
                  <dt>{content.aiLabel}</dt>
                  <dd>{stage.ai}</dd>
                </div>
                <div>
                  <dt>{content.humanLabel}</dt>
                  <dd>{stage.human}</dd>
                </div>
                <div>
                  <dt>{content.checkLabel}</dt>
                  <dd>{stage.check}</dd>
                </div>
              </dl>
            </article>
          ))
        }
      </div>

      <EvidenceBand locale={locale} level="advice" summary={content.stagesEvidence} />
    </section>

    {/*
      The page committed to the reader who stops early in one sentence at the
      top and then gave them no structure at all. This block is where Explore
      and Prototype finish, so the three tightening sections that follow read
      as the case where the work does not stop rather than as what happens
      next.
    */}
    <section class="prototype-section">
      <h2>{content.stoppingHeading}</h2>
      {content.stoppingParagraphs.map((paragraph) => <p class="prototype-section__lead">{paragraph}</p>)}
    </section>

    <section class="prototype-section">
      <h2>{content.transitionsHeading}</h2>
      <p class="prototype-section__lead">{content.transitionsLead}</p>
      <ol class="boundary-questions">
        {
          content.transitions.map((item, index) => (
            <li>
              <p class="boundary-questions__number" aria-hidden="true">{index + 1}</p>
              <div>
                <h3>{item.title}</h3>
                <p class="boundary-questions__question">{item.question}</p>
                <p class="boundary-questions__reason">{item.reason}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <StopCondition
      locale={locale}
      description={content.unsafeDescription}
      alternative={content.unsafeAlternative}
    />

    <ArtifactLink
      locale={locale}
      title={content.artifactTitle}
      description={content.artifactDescription}
      href={artifactHref}
      status={content.artifactStatus}
      external
    />

    {/*
      Two destinations, because the reader job genuinely forks here. Checking
      what came back is the next job at every stage — an answer, a change or an
      action — while granting an agent access is only the next job for someone
      whose work is moving on. The single exit used to be the second of those,
      which closed the page on the one reader it had promised not to abandon.
    */}
    <NextStep
      locale={locale}
      primary={{
        label: content.nextTitle,
        description: content.nextDescription,
        href: toHref(getLocalizedPath(locale, "secureSetupChecking")),
      }}
      secondary={{
        label: content.nextSecondaryTitle,
        href: toHref(getLocalizedPath(locale, "secureSetupAccess")),
      }}
    />
  </article>
</Base>
