---
import { getEvidenceCopy, type EvidenceLevel } from "../data/evidence";
import { getLocalizedPath } from "../i18n/routes";
import { getUi, type SiteLocale } from "../i18n/ui";

interface Props {
  level: EvidenceLevel;
  locale: SiteLocale;
  /** ISO date the claim was last verified. Expected for fact, measured and law. */
  checked?: string;
}

const { level, locale, checked } = Astro.props;
const { label, meaning } = getEvidenceCopy(locale, level);
const ui = getUi(locale);

const base = import.meta.env.BASE_URL;
const toHref = (path: string) =>
  path === "/" ? base : `${base}${path.replace(/^\//, "")}`;
const methodHref = toHref(getLocalizedPath(locale, "evidenceMethod"));

// The badge is a link, not a decorated paragraph. What a level means has to
// reach a keyboard user and a screen reader, and the previous markup carried
// it only in `title` (mouse) and in `aria-label` on a <p>, whose role does not
// reliably support a name.
//
// The accessible name is the level, its date and where the link goes. The full
// definition lives on the evidence-method page rather than being read out again
// at every labelled section — eight identical paragraphs is not disclosure.
//
// Muted ink rather than heading ink: the badge sits between a heading and its
// first paragraph, so it should be inspectable without competing with them.
const tone: Record<EvidenceLevel, string> = {
  fact: "border-black/20 dark:border-white/25",
  measured: "border-black/20 dark:border-white/25",
  law: "border-[var(--color-accent)]/50",
  assessment: "border-dashed border-black/30 dark:border-white/35",
  advice: "border-dashed border-black/30 dark:border-white/35",
};
---

<a
  href={methodHref}
  title={meaning}
  class={`inline-flex items-baseline gap-x-2 rounded-full border px-3 py-1 text-xs text-[var(--ink-muted)] no-underline ${tone[level]}`}
>
  <span class="font-semibold uppercase tracking-[0.06em]">{label}</span>
  {checked && <time datetime={checked}>{checked}</time>}
  <span class="sr-only">{`. ${ui.evidenceMethod}`}</span>
</a>
