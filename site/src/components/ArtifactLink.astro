---
import { getPagePrimitiveCopy, type ArtifactStatus } from "../data/page-primitives";
import type { SiteLocale } from "../i18n/ui";

interface Props {
  locale: SiteLocale;
  title: string;
  description: string;
  href: string;
  /**
   * The blueprint's canonical status, as a semantic key rather than a word to
   * render. `draft` means the payload is complete and has never been run
   * against a real project — which is a claim about reliability a reader can
   * act on, and not what the English word "draft" says on its own. The key is
   * mapped to a sentence per locale in `page-primitives.ts`, and
   * `check-conformance.sh` asserts it still agrees with `blueprint.yml`.
   */
  status?: ArtifactStatus;
  external?: boolean;
}

const { locale, title, description, href, status, external = false } = Astro.props;
const copy = getPagePrimitiveCopy(locale);
---

{/*
  Reader value first, metadata second. The linked title is the thing on offer,
  so it opens the block; what to do with it and what is true of it follow the
  description as one muted line.
*/}
<aside class="artifact-link">
  <h2>
    <a href={href} target={external ? "_blank" : undefined} rel={external ? "noreferrer" : undefined}>
      {title}<span aria-hidden="true"> {external ? "↗" : "→"}</span>
      {external && <span class="sr-only"> ({copy.opensInNewWindow})</span>}
    </a>
  </h2>
  <p class="artifact-link__description">{description}</p>
  <p class="artifact-link__meta">
    {copy.copyableArtifact}{status && ` — ${copy.artifactStatus[status]}`}
  </p>
</aside>
