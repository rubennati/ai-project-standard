---
import EvidenceBand from "./EvidenceBand.astro";
import PageIntroduction from "./PageIntroduction.astro";
import NextStep from "./NextStep.astro";
import StopCondition from "./StopCondition.astro";
import {
  CHECKED,
  getConnectAiToolsData,
  sources,
} from "../data/data-flows/connect-ai-to-tools-and-data";
import { getLocalizedPath } from "../i18n/routes";
import type { SiteLocale } from "../i18n/ui";
import Base from "../layouts/Base.astro";

interface Props {
  locale: SiteLocale;
}

const { locale } = Astro.props;
const content = getConnectAiToolsData(locale);
const base = import.meta.env.BASE_URL;
const toHref = (path: string) =>
  path === "/" ? base : `${base}${path.replace(/^\//, "")}`;
---

<Base
  title={content.title}
  description={content.description}
  ogType="article"
  schemaType="Article"
  locale={locale}
  routeKey="dataFlowsConnectAiTools"
>
  <article class="layout-reading prototype-path">
    <PageIntroduction
      locale={locale}
      job="decision"
      title={content.title}
      answer={content.answer}
      lead={content.lead}
      fit={content.fit}
      metadata={[{ label: content.checkedLabel, value: CHECKED, datetime: CHECKED }]}
    />

    <section class="prototype-section">
      <h2>{content.capabilityHeading}</h2>
      <p class="prototype-section__lead">{content.capabilityLead}</p>

      <div class="outcome-grid">
        {
          content.opportunities.map((opportunity) => (
            <article class="outcome-card">
              <h3>{opportunity.title}</h3>
              <dl>
                <div>
                  <dt>{content.outcomeLabel}</dt>
                  <dd>{opportunity.outcome}</dd>
                </div>
                <div>
                  <dt>{content.simplerLabel}</dt>
                  <dd>{opportunity.simplerWhen}</dd>
                </div>
              </dl>
            </article>
          ))
        }
      </div>
    </section>

    <section class="prototype-section">
      <h2>{content.howHeading}</h2>
      <p class="prototype-section__lead">{content.howLead}</p>
      <ol class="boundary-questions">
        {
          content.howSteps.map((step, index) => (
            <li>
              <p class="boundary-questions__number" aria-hidden="true">{index + 1}</p>
              <div>
                <h3>{step.title}</h3>
                <p class="boundary-questions__body">{step.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
      <EvidenceBand
        locale={locale}
        level="fact"
        checked={CHECKED}
        summary={content.architectureEvidence}
        sourceLabel={content.architectureSource}
        sourceHref={sources.architecture}
      />
    </section>

    <section class="prototype-section">
      <h2>{content.exampleHeading}</h2>
      <p class="prototype-section__lead">{content.exampleLead}</p>
      <ol class="boundary-questions">
        {
          content.exampleBeats.map((beat, index) => (
            <li>
              <p class="boundary-questions__number" aria-hidden="true">{index + 1}</p>
              <div>
                <h3>{beat.title}</h3>
                <p class="boundary-questions__body">{beat.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
      <p class="mt-6 max-w-2xl text-sm leading-6 text-zinc-700 dark:text-zinc-300">
        {content.exampleNote}
      </p>
      <p class="mt-3 text-sm">
        <a href={toHref(content.exampleLink.href)}>{content.exampleLink.label}</a>
      </p>
    </section>

    <section class="prototype-section">
      <h2>{content.decidesHeading}</h2>
      {
        content.decidesParagraphs.map((paragraph) => (
          <p class="mt-4 max-w-2xl leading-7">{paragraph}</p>
        ))
      }
      <p class="mt-4">
        <a href={toHref(content.decidesLink.href)}>{content.decidesLink.label}</a>
      </p>
    </section>

    <section class="prototype-section">
      <h2>{content.boundaryHeading}</h2>
      <p class="prototype-section__lead">{content.boundaryLead}</p>
      <ol class="boundary-questions">
        {
          content.boundaryQuestions.map((item, index) => (
            <li>
              <p class="boundary-questions__number" aria-hidden="true">{index + 1}</p>
              <div>
                <h3>{item.title}</h3>
                <p class="boundary-questions__question">{item.question}</p>
                <p class="boundary-questions__reason">{item.reason}</p>
              </div>
            </li>
          ))
        }
      </ol>
      <p class="mt-6 max-w-2xl leading-7">{content.boundaryClose}</p>
      <EvidenceBand
        locale={locale}
        level="fact"
        checked={CHECKED}
        summary={content.authorizationEvidence}
        sourceLabel={content.authorizationSource}
        sourceHref={sources.authorization}
      />
    </section>

    <StopCondition
      locale={locale}
      description={content.unsafeDescription}
      alternative={content.unsafeAlternative}
    />

    <div class="prototype-section">
      <p class="max-w-2xl leading-7">{content.glossaryLead}</p>
      <ul class="term-link-grid">
        {
          content.glossaryLinks.map((term) => (
            <li>
              <a
                href={toHref(
                  getLocalizedPath(locale, "glossaryTerm", { slug: term.slug }),
                )}
              >
                <strong>{term.label}</strong>
                <span>{term.description}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <NextStep
      locale={locale}
      primary={{
        label: content.nextTitle,
        description: content.nextDescription,
        href: toHref(getLocalizedPath(locale, "secureSetupAccess")),
      }}
    />
  </article>
</Base>
