---
import EvidenceLegend from "./EvidenceLegend.astro";
import { getEvidenceMethod } from "../data/evidence-method";
import { getUi, type SiteLocale } from "../i18n/ui";

interface Props {
  locale: SiteLocale;
}

const { locale } = Astro.props;
const ui = getUi(locale);
const content = getEvidenceMethod(locale);
---

<article class="layout-reading">
  <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">{ui.evidenceMethodTitle}</h1>
  <p class="mt-4 text-lg leading-8">{ui.howToReadLead}</p>

  <section class="mt-12">
    <h2 class="text-xl font-semibold">{content.levelsHeading}</h2>
    <div class="mt-6 rounded-lg border border-black/10 p-6 dark:border-white/10">
      <EvidenceLegend locale={locale} />
    </div>
  </section>

  <section class="mt-12">
    <h2 class="text-xl font-semibold">{content.sourcesHeading}</h2>
    <p class="mt-3 leading-7">{content.sourcesLead}</p>
    <ol class="mt-4 flex list-decimal flex-col gap-2 pl-5 leading-7">
      {content.sources.map((source) => <li>{source}</li>)}
    </ol>
  </section>
</article>
