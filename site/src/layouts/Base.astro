---
import "../styles/global.css";
import SEO from "../components/SEO.astro";
import JsonLd from "../components/JsonLd.astro";
import LanguageSwitch from "../components/LanguageSwitch.astro";
import { getLocalizedPath, type LocalizedRouteKey } from "../i18n/routes";
import { getUi, type SiteLocale } from "../i18n/ui";
import { getIdentity } from "../data/identity";
import { repoUrl } from "../data/site";

interface Props {
  title: string;
  description?: string;
  ogType?: "website" | "article";
  schemaType?: "WebSite" | "WebPage" | "AboutPage" | "CollectionPage" | "Article";
  /** Editorial publication date, for articles that have one. */
  datePublished?: string;
  extraSchemas?: Record<string, unknown>[];
  locale?: SiteLocale;
  routeKey?: LocalizedRouteKey;
  termSlug?: string;
  /** Overridden by pages rendered from `docs/`, which are MIT, not CC BY. */
  license?: string;
}

const {
  title,
  description,
  ogType = "website",
  schemaType = "WebPage",
  datePublished,
  extraSchemas = [],
  locale = "en",
  routeKey,
  termSlug,
  license,
} = Astro.props;
const base = import.meta.env.BASE_URL;
const ui = getUi(locale);
const identity = getIdentity(locale);
// The fallback has to be in this locale, so it cannot be a destructuring
// default. Every page passes its own description and `site/AGENTS.md` says to;
// this is what a page gets if one is ever forgotten, and it used to describe
// the repository standard rather than the site.
const pageDescription = description ?? identity.summary;
const lang = locale;
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const toHref = (path: string) => (path === "/" ? base : `${base}${path.replace(/^\//, "")}`);
// hreflang needs fully-qualified URLs. Relative ones are silently ignored, so
// the whole language pairing counts for nothing — which is what Lighthouse
// flagged, and what a crawler would have done quietly.
const toAbsolute = (path: string) => new URL(toHref(path), Astro.site).toString();
const localizedHome = toHref(getLocalizedPath(locale, "home"));
const localizedAbout = toHref(getLocalizedPath(locale, "about"));
const localizedGlossary = toHref(getLocalizedPath(locale, "glossaryIndex"));
const localizedLaw = toHref(getLocalizedPath(locale, "law"));
const localizedLegal = toHref(getLocalizedPath(locale, "legalNotice"));
const localizedPrivacy = toHref(getLocalizedPath(locale, "privacyPolicy"));
const isActive = (href: string) => {
  const normalized = href.replace(/\/$/, "") || "/";
  return currentPath === normalized || (normalized !== "/" && currentPath.startsWith(`${normalized}/`));
};
const alternates = routeKey
  ? [
      { hreflang: "en", href: toAbsolute(getLocalizedPath("en", routeKey, routeKey === "glossaryTerm" ? { slug: termSlug } : undefined)) },
      { hreflang: "de", href: toAbsolute(getLocalizedPath("de", routeKey, routeKey === "glossaryTerm" ? { slug: termSlug } : undefined)) },
    ]
  : [];
const xDefaultHref = routeKey ? toAbsolute(getLocalizedPath("en", routeKey, routeKey === "glossaryTerm" ? { slug: termSlug } : undefined)) : undefined;
const enLanguageHref = routeKey
  ? toHref(getLocalizedPath("en", routeKey, routeKey === "glossaryTerm" ? { slug: termSlug } : undefined))
  : locale === "en"
    ? toHref(currentPath)
    : undefined;
const deLanguageHref = routeKey
  ? toHref(getLocalizedPath("de", routeKey, routeKey === "glossaryTerm" ? { slug: termSlug } : undefined))
  : locale === "de"
    ? toHref(currentPath)
    : undefined;

// One entry per reader journey, in the order the questions arrive: what AI is
// for, how to work with it, what it can reach and do, how to keep that safe and
// check it. No "Home" entry — the wordmark already has that job.
//
// Law, Blog and About are deliberately absent. Each is reference, format or
// trust rather than a journey a reader arrives with. Law and About are in the
// footer; Blog is not, because one post per locale is not a destination a
// reader returns to. Reference is not a fifth entry for the same reason as
// Law: looking a term up interrupts a journey instead of being one.
const primaryNav = [
  { href: toHref(getLocalizedPath(locale, "useCases")), label: ui.useCases },
  { href: toHref(getLocalizedPath(locale, "start")), label: ui.start },
  { href: toHref(getLocalizedPath(locale, "dataFlows")), label: ui.dataFlows },
  { href: toHref(getLocalizedPath(locale, "secureSetup")), label: ui.secureSetup },
];

const copyrightYear = new Date().getFullYear();

// Pre-filled issue so a reader reporting a problem does not have to describe
// which page they were on — the title and URL are already in the body. The
// template copy follows the reader's locale; the destination does not, because
// there is one issue tracker.
const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();
const reportProblemUrl = `${repoUrl}/issues/new?${new URLSearchParams({
  title: `Site: ${title}`,
  body: `**${ui.reportProblemPage}:** ${title}\n**${ui.reportProblemUrl}:** ${pageUrl}\n\n**${ui.reportProblemBody}**\n\n`,
}).toString()}`;

// Three groups: something in the way (a word, a rule), who is behind this, and
// the statutory/disclosure surfaces a reader looks for by name rather than by
// journey — legal notice, privacy, and the two report paths, which used to sit
// in an unheaded row and the closing legal bar respectively.
//
// The four header journeys are deliberately absent — see `.ai/decisions.md`,
// 2026-08-24. A stranded reader is answered by the page's own next step, not by
// putting every primary destination on a third surface of the same screen.
const footerSections = [
  {
    id: "footer-terms-and-law",
    heading: ui.footerTermsAndLaw,
    links: [
      { href: localizedGlossary, label: ui.glossary },
      { href: localizedLaw, label: ui.law },
    ],
  },
  {
    id: "footer-about-site",
    heading: ui.footerAboutSite,
    links: [
      { href: localizedAbout, label: ui.about },
      { href: toHref(getLocalizedPath(locale, "evidenceMethod")), label: ui.evidenceMethod },
      { href: repoUrl, label: ui.projectOnGithub, external: true },
    ],
  },
  {
    id: "footer-legal",
    heading: ui.footerLegal,
    links: [
      { href: localizedLegal, label: ui.legalNotice },
      { href: localizedPrivacy, label: ui.privacyPolicy },
      { href: reportProblemUrl, label: ui.reportProblem, external: true },
      { href: `${repoUrl}/security/advisories/new`, label: ui.reportVulnerability, external: true },
    ],
  },
];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0a3a8c" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#243b66" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href={`${base}icon.svg`} type="image/svg+xml" />
    <link rel="manifest" href={`${base}manifest.webmanifest`} />
    <SEO title={title} description={pageDescription} ogType={ogType} alternates={alternates} xDefaultHref={xDefaultHref} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${ui.blogTitle} — AI Standard`}
      href={toAbsolute(locale === "de" ? "/de/blog/rss.xml" : "/blog/rss.xml")}
    />
    <JsonLd title={title} description={pageDescription} pageType={schemaType} extra={extraSchemas} lang={lang} license={license} datePublished={datePublished} />
  </head>
  <body class="flex min-h-screen flex-col">
    <a href="#main-content" class="skip-link">{ui.skipToMain}</a>
    <header class="site-header">
      <div class="layout-shell site-header__inner">
        {/* Weight and colour split the name into readable parts, the way
            SecDockBlue does. Live text rather than an image, and a flat accent
            rather than a gradient, so the >7:1 contrast still holds. */}
        <a href={localizedHome} class="site-wordmark">
          <span class="site-wordmark__ai font-bold text-[var(--color-accent)]">AI</span>{" "}<span
            class="font-semibold">Standard</span
          >
        </a>

        <div class="site-header__actions">
          {/*
            A disclosure rather than a second mobile navigation tree. At the
            desktop breakpoint the same links become an inline row. The
            language control stays outside this disclosure, so it remains
            discoverable before the menu is opened.
          */}
          <div class="site-header__language site-header__language--mobile">
            <LanguageSwitch
              currentLocale={locale}
              enHref={enLanguageHref}
              deHref={deLanguageHref}
            />
          </div>
          <details class="site-nav">
            <summary class="site-nav__toggle">
              <span class="sr-only">{ui.menu}</span>
              <svg
                aria-hidden="true"
                class="site-nav__icon site-nav__icon--menu"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
              >
                <path d="M4 7h16M4 12h16M4 17h16"></path>
              </svg>
              <svg
                aria-hidden="true"
                class="site-nav__icon site-nav__icon--close"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
              >
                <path d="m6 6 12 12M18 6 6 18"></path>
              </svg>
            </summary>
            <div class="site-nav__panel">
              <nav aria-label={ui.primaryNavigation} class="site-nav__links">
                {
                  primaryNav.map((item) => (
                    <a
                      href={item.href}
                      aria-current={isActive(item.href) ? "page" : undefined}
                      class="site-nav__link"
                    >
                      {item.label}
                    </a>
                  ))
                }
              </nav>
            </div>
          </details>
          <div class="site-header__language site-header__language--desktop">
            <LanguageSwitch
              currentLocale={locale}
              enHref={enLanguageHref}
              deHref={deLanguageHref}
            />
          </div>
        </div>
      </div>
    </header>

    <main id="main-content" class="layout-wide site-main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="layout-shell site-footer__inner">
        <div class="site-footer__grid">
          {/* Wordmark only. The identity sentence belongs where a reader is
              deciding what this is — the homepage lead, About, the metadata —
              not at the end of an article they have already read. Removing the
              restatement changes presentation only; `data/identity.ts` and the
              machine surfaces are untouched. It is also the reader's only path
              home from the bottom of a long page, because the header does not
              follow them down. */}
          <div class="site-footer__brand">
            <a href={localizedHome} class="site-wordmark">
              <span class="site-wordmark__ai font-bold text-[var(--color-accent)]">AI</span>{" "}<span
                class="font-semibold">Standard</span
              >
            </a>
          </div>
          {
            footerSections.map((section) => (
              <nav aria-labelledby={section.id} class="site-footer__section">
                <h2 id={section.id}>{section.heading}</h2>
                <ul>
                  {section.links.map((link) => (
                    <li>
                      <a
                        href={link.href}
                        class="site-footer__link"
                      >
                        {link.label}
                        {"external" in link && link.external && (
                          <span aria-hidden="true" class="ml-0.5">
                            ↗
                          </span>
                        )}
                      </a>
                    </li>
                  ))}
                </ul>
              </nav>
            ))
          }
        </div>

        <div class="site-footer__closing">
          {/* The legal bar. Legal notice, privacy and the two report paths
              moved into the third column above, where a reader looks for them
              by name. What is left here is copyright on one side and the two
              licences grouped with the language switch on the other — both are
              utility controls a returning reader scans for at the same edge,
              rather than the licences floating alone in the middle of an empty
              row. */}
          <p class="site-footer__fine-print">
            <span>© {copyrightYear} AI Standard</span>
          </p>
          <div class="site-footer__closing-utilities">
            <p class="site-footer__fine-print">
              <span>
                {ui.finePrintCode}{" "}
                <a href={`${repoUrl}/blob/main/LICENSE`}>MIT</a>
              </span>
              <span>
                {ui.finePrintSiteContent}{" "}
                <a href="https://creativecommons.org/licenses/by/4.0/" rel="license"
                  >{ui.contentLicence}</a
                >
              </span>
            </p>
            <LanguageSwitch
              currentLocale={locale}
              enHref={enLanguageHref}
              deHref={deLanguageHref}
            />
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
