---
import Base from "../../layouts/Base.astro";
import { getUi } from "../../i18n/ui";
import { getBeforeYouGrantAccess, CHECKED } from "../../data/secure-setup/before-you-grant-access";

const locale = "en" as const;
const base = import.meta.env.BASE_URL;
const ui = getUi(locale);

const articles = [
  { ...getBeforeYouGrantAccess(locale), href: `${base}secure-setup/before-you-grant-access`, checked: CHECKED },
];
---

<Base
  title={ui.secureSetupTitle}
  description={ui.secureSetupDescription}
  schemaType="CollectionPage"
  locale={locale}
  routeKey="secureSetup"
>
  <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">{ui.secureSetupTitle}</h1>
  <p class="mt-4 max-w-2xl text-lg leading-8">{ui.secureSetupIntro}</p>

  <ul class="mt-10 flex max-w-2xl flex-col gap-6">
    {
      articles.map((article) => (
        <li class="rounded-lg border border-black/10 p-6 dark:border-white/10">
          <h2 class="text-lg font-semibold">
            <a href={article.href}>{article.title}</a>
          </h2>
          <p class="mt-2 leading-7">{article.description}</p>
          <p class="mt-3 text-sm text-zinc-600 dark:text-zinc-400">
            <time datetime={article.checked}>{article.checked}</time>
          </p>
        </li>
      ))
    }
  </ul>

  <p class="mt-8 max-w-2xl leading-7 text-zinc-700 dark:text-zinc-300">{ui.secureSetupMore}</p>
</Base>
