---
import SecureSetupContent from "../../components/SecureSetupContent.astro";
import Base from "../../layouts/Base.astro";
import { getControlLifecycle } from "../../data/secure-setup/control-lifecycle";

const locale = "en" as const;
const content = getControlLifecycle(locale);
---

<Base
  title={content.title}
  description={content.description}
  schemaType="CollectionPage"
  locale={locale}
  routeKey="secureSetup"
>
  <SecureSetupContent locale={locale} />
</Base>
