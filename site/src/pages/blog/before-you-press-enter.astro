---
import Base from "../../layouts/Base.astro";
import EvidenceLabel from "../../components/EvidenceLabel.astro";
import JourneyFigure from "../../components/JourneyFigure.astro";
import ReachFigure from "../../components/ReachFigure.astro";
import { getUi } from "../../i18n/ui";
import { getLocalizedPath } from "../../i18n/routes";
import { getBeforeYouPressEnter, PUBLISHED } from "../../data/blog/before-you-press-enter";

const locale = "en" as const;
const ui = getUi(locale);
const article = getBeforeYouPressEnter(locale);
---

<Base
  title={article.title}
  description={article.description}
  ogType="article"
  schemaType="Article"
  locale={locale}
  routeKey="blogBeforeYouPressEnter"
>
  <article class="max-w-2xl">
    <p class="text-sm text-zinc-700 dark:text-zinc-300">
      <a href={getLocalizedPath(locale, "blogIndex")}>{ui.blogBackToIndex}</a>
      <span aria-hidden="true"> · </span>
      <time datetime={PUBLISHED}>{PUBLISHED}</time>
    </p>

    <h1 class="mt-2 text-3xl font-bold tracking-tight sm:text-4xl">{article.title}</h1>
    <p class="mt-4 text-lg leading-8">{article.lead}</p>

    {
      article.sections.map((section) => (
        <section class="mt-10">
          <h2 class="text-xl font-semibold">{section.heading}</h2>
          {section.level && (
            <div class="mt-2">
              <EvidenceLabel level={section.level} locale={locale} checked={section.checked} />
            </div>
          )}
          {section.paragraphs.map((paragraph) => (
            <p class="mt-3 leading-7">{paragraph}</p>
          ))}
          {section.list && (
            <ul class="mt-3 flex list-disc flex-col gap-1 pl-5 leading-7">
              {section.list.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          )}
          {section.figure?.kind === "journey" && (
            <JourneyFigure
              caption={section.figure.caption}
              stops={section.figure.stops}
              markIndex={section.figure.markIndex}
              markLabel={section.figure.markLabel}
            />
          )}
          {section.figure?.kind === "reach" && (
            <ReachFigure caption={section.figure.caption} rows={section.figure.rows} />
          )}
          {section.links && (
            <ul class="mt-3 flex flex-col gap-1 text-sm">
              {section.links.map((link) => (
                <li>
                  <a href={link.href}>{link.label}</a>
                </li>
              ))}
            </ul>
          )}
        </section>
      ))
    }
  </article>
</Base>
