---
import Base from "../../../layouts/Base.astro";
import { getUi } from "../../../i18n/ui";
import { getWhatMakesItOpenSource, CHECKED as CHECKED_DEF } from "../../../data/open-source/what-makes-it-open-source";
import { getChoosingALicence, CHECKED as CHECKED_LIC } from "../../../data/open-source/choosing-a-licence";
import { getCodeWrittenAtWork, CHECKED as CHECKED_WORK } from "../../../data/open-source/code-written-at-work";

const locale = "de" as const;
const base = import.meta.env.BASE_URL;
const ui = getUi(locale);

const articles = [
  { ...getWhatMakesItOpenSource(locale), href: `${base}de/open-source/what-makes-it-open-source`, checked: CHECKED_DEF },
  { ...getChoosingALicence(locale), href: `${base}de/open-source/choosing-a-licence`, checked: CHECKED_LIC },
  { ...getCodeWrittenAtWork(locale), href: `${base}de/open-source/code-written-at-work`, checked: CHECKED_WORK },
];
---

<Base
  title={ui.openSourceTitle}
  description={ui.openSourceDescription}
  schemaType="CollectionPage"
  locale={locale}
  routeKey="openSource"
>
  <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">{ui.openSourceTitle}</h1>
  <p class="mt-4 max-w-2xl text-lg leading-8">{ui.openSourceIntro}</p>
  {/* Work in progress is stated, but not as the page's last word — the
      articles are what the reader came for, so they close the page. */}
  <p class="mt-4 max-w-2xl text-sm leading-6 text-zinc-700 dark:text-zinc-300">{ui.openSourceMore}</p>

  <ul class="mt-10 flex max-w-2xl flex-col gap-6">
    {
      articles.map((article) => (
        <li class="rounded-lg border border-black/10 p-6 dark:border-white/10">
          <h2 class="text-lg font-semibold">
            <a href={article.href}>{article.title}</a>
          </h2>
          <p class="mt-2 leading-7">{article.description}</p>
          <p class="mt-3 text-sm text-zinc-600 dark:text-zinc-400">
            <time datetime={article.checked}>{article.checked}</time>
          </p>
        </li>
      ))
    }
  </ul>

</Base>

