---
import Base from "../../../layouts/Base.astro";
import EvidenceLabel from "../../../components/EvidenceLabel.astro";
import ReachFigure from "../../../components/ReachFigure.astro";
import { getChoosingALicence } from "../../../data/open-source/choosing-a-licence";

const locale = "de" as const;
const article = getChoosingALicence(locale);
---

<Base
  title={article.title}
  description={article.description}
  ogType="article"
  schemaType="Article"
  locale={locale}
  routeKey="openSourceLicence"
>
  <article class="layout-reading">
    <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">{article.title}</h1>
    <p class="mt-4 text-lg leading-8">{article.lead}</p>

    {
      article.sections.map((section) => (
        <section class="mt-10">
          <h2 class="text-xl font-semibold">{section.heading}</h2>
          {section.level && (
            <div class="mt-2">
              <EvidenceLabel level={section.level} locale={locale} checked={section.checked} />
            </div>
          )}
          {section.paragraphs.map((paragraph) => (
            <p class="mt-3 leading-7">{paragraph}</p>
          ))}
          {section.list && (
            <ul class="mt-3 flex list-disc flex-col gap-1 pl-5 leading-7">
              {section.list.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          )}
          {section.figure?.kind === "reach" && (
            <ReachFigure caption={section.figure.caption} rows={section.figure.rows} />
          )}
          {section.links && (
            <ul class="mt-3 flex flex-col gap-1 text-sm">
              {section.links.map((link) => (
                <li>
                  <a href={link.href}>{link.label}</a>
                </li>
              ))}
            </ul>
          )}
        </section>
      ))
    }
  </article>
</Base>
