---
import NextStep from "../../../components/NextStep.astro";
import { getLocalizedPath } from "../../../i18n/routes";
import Base from "../../../layouts/Base.astro";
import EvidenceLabel from "../../../components/EvidenceLabel.astro";
import ReachFigure from "../../../components/ReachFigure.astro";
import { getWhereKnowledgeLives, getWhereKnowledgeLivesNextStep } from "../../../data/data-flows/where-knowledge-lives";

const locale = "de" as const;
const article = getWhereKnowledgeLives(locale);
const next = getWhereKnowledgeLivesNextStep(locale);
const base = import.meta.env.BASE_URL;
const toHref = (path: string) =>
  path === "/" ? base : `${base}${path.replace(/^\//, "")}`;
---

<Base
  title={article.title}
  description={article.description}
  ogType="article"
  schemaType="Article"
  locale={locale}
  routeKey="dataFlowsKnowledgeSources"
>
  <article class="layout-reading">
    <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">{article.title}</h1>
    {article.subtitle && (
      <p class="mt-3 text-lg text-zinc-700 dark:text-zinc-300">{article.subtitle}</p>
    )}
    <p class="mt-4 text-lg leading-8">{article.lead}</p>

    {
      article.sections.map((section) => (
        <section class="mt-10">
          <h2 class="text-xl font-semibold">{section.heading}</h2>
          {section.level && (
            <div class="mt-2">
              <EvidenceLabel level={section.level} locale={locale} checked={section.checked} />
            </div>
          )}
          {section.paragraphs.map((paragraph) => (
            <p class="mt-3 leading-7">{paragraph}</p>
          ))}
          {section.list && (
            <ul class="mt-3 flex list-disc flex-col gap-1 pl-5 leading-7">
              {section.list.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          )}
          {section.figure?.kind === "reach" && (
            <ReachFigure caption={section.figure.caption} rows={section.figure.rows} />
          )}
          {section.links && (
            <ul class="mt-3 flex flex-col gap-1 text-sm">
              {section.links.map((link) => (
                <li>
                  <a href={link.href}>{link.label}</a>
                </li>
              ))}
            </ul>
          )}
        </section>
      ))
    }
    <NextStep
      locale={locale}
      primary={{
        label: next.label,
        description: next.description,
        href: toHref(getLocalizedPath(locale, "dataFlowsConnectAiTools")),
      }}
    />
  </article>
</Base>
