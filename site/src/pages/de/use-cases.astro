---
import UseCasesContent from "../../components/UseCasesContent.astro";
import { getUseCases } from "../../data/use-cases";
import Base from "../../layouts/Base.astro";

const locale = "de" as const;
const content = getUseCases(locale);
---

<Base
  title={content.title}
  description={content.description}
  schemaType="CollectionPage"
  locale={locale}
  routeKey="useCases"
>
  <UseCasesContent locale={locale} />
</Base>
