---
import Base from "../../layouts/Base.astro";
import { getUi } from "../../i18n/ui";
import { getBlogPosts, getPlannedPosts } from "../../data/blog";
import { author } from "../../data/site";

const locale = "de" as const;
const ui = getUi(locale);
const posts = getBlogPosts(locale);
const planned = getPlannedPosts(locale);
---

<Base
  title={`${ui.blogTitle} — AI Standard`}
  description={ui.blogDescription}
  schemaType="CollectionPage"
  locale={locale}
  routeKey="blogIndex"
>
  <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">{ui.blogTitle}</h1>
  <p class="mt-4 max-w-2xl text-lg leading-8">{ui.blogIntro}</p>
  <p class="mt-3 text-sm">
    <a href="/de/blog/rss.xml" type="application/rss+xml">{ui.blogFeed}</a>
  </p>

  <ul class="mt-10 flex max-w-2xl flex-col gap-y-8">
    {
      posts.map((post) => (
        <li>
          <p class="text-sm text-zinc-700 dark:text-zinc-300">
            <time datetime={post.published}>{post.published}</time>
            <span aria-hidden="true"> · </span>
            <span>Von {author}</span>
          </p>
          <h2 class="mt-1 text-xl font-semibold">
            <a href={post.href}>{post.title}</a>
          </h2>
          <p class="mt-2 leading-7">{post.description}</p>
        </li>
      ))
    }
  </ul>

  <section class="mt-14 max-w-2xl border-t border-black/10 pt-6 dark:border-white/10">
    <h2 class="text-xl font-semibold">{ui.blogPlanned}</h2>
    <p class="mt-3 leading-7">{ui.blogPlannedIntro}</p>
    <ul class="mt-3 flex list-disc flex-col gap-1 pl-5 leading-7">
      {planned.map((title) => <li>{title}</li>)}
    </ul>
  </section>
</Base>
