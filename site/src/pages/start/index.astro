---
import Base from "../../layouts/Base.astro";
import { getUi } from "../../i18n/ui";
import { getEmployeeStart, CHECKED as CHECKED_EMP } from "../../data/start/employee";
import { getDecisionMakerStart, CHECKED as CHECKED_DEC } from "../../data/start/decision-maker";
import { getWhatItIsDoing, CHECKED as CHECKED_WID } from "../../data/start/what-it-is-doing";
import { getVibeCoding, REVIEWED as REVIEWED_VIBE } from "../../data/start/vibe-coding";

const locale = "en" as const;
const base = import.meta.env.BASE_URL;
const ui = getUi(locale);

const articles = [
  { ...getWhatItIsDoing(locale), href: `${base}start/what-it-is-doing`, checked: CHECKED_WID },
  { ...getEmployeeStart(locale), href: `${base}start/employee`, checked: CHECKED_EMP },
  { ...getDecisionMakerStart(locale), href: `${base}start/decision-maker`, checked: CHECKED_DEC },
  { ...getVibeCoding(locale), href: `${base}start/vibe-coding`, checked: REVIEWED_VIBE },
];
---

<Base
  title={ui.startTitle}
  description={ui.startDescription}
  schemaType="CollectionPage"
  locale={locale}
  routeKey="start"
>
  <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">{ui.startTitle}</h1>
  <p class="mt-4 max-w-2xl text-lg leading-8">{ui.startIntro}</p>

  <ul class="mt-10 flex max-w-2xl flex-col gap-6">
    {
      articles.map((article) => (
        <li class="rounded-lg border border-black/10 p-6 dark:border-white/10">
          <h2 class="text-lg font-semibold">
            <a href={article.href}>{article.title}</a>
          </h2>
          <p class="mt-2 leading-7">{article.description}</p>
          <p class="mt-3 text-sm text-zinc-600 dark:text-zinc-400">
            <time datetime={article.checked}>{article.checked}</time>
          </p>
        </li>
      ))
    }
  </ul>

  <p class="mt-8 max-w-2xl leading-7 text-zinc-700 dark:text-zinc-300">{ui.startMore}</p>
</Base>
