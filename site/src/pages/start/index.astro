---
import StartHubContent from "../../components/StartHubContent.astro";
import Base from "../../layouts/Base.astro";
import { getStartHub } from "../../data/start/collaboration-forms";

const locale = "en" as const;
const content = getStartHub(locale);
---

<Base
  title={content.title}
  description={content.description}
  schemaType="CollectionPage"
  locale={locale}
  routeKey="start"
>
  <StartHubContent locale={locale} />
</Base>
