---
import DataFlowsContent from "../../components/DataFlowsContent.astro";
import Base from "../../layouts/Base.astro";
import { getReachModel } from "../../data/data-flows/reach-model";

const locale = "en" as const;
const content = getReachModel(locale);
---

<Base
  title={content.title}
  description={content.description}
  schemaType="CollectionPage"
  locale={locale}
  routeKey="dataFlows"
>
  <DataFlowsContent locale={locale} />
</Base>
